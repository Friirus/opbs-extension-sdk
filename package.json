{
  "name": "@opbs/extension-sdk",
  "version": "0.36.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Friirus/opbs-extension-sdk"
  },
  "files": [
    "dist",
    "loader",
    "CHANGELOG.md",
    "EXTENSIONS.md",
    "COMPATIBILITY.md"
  ],
  "bin": {
    "opbs-extension": "dist/bin/opbs-extension.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "default": "./dist/loader/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@opbs/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
